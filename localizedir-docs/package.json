    "qa": "node scripts/qa-screenshots.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#4bb9e47833c48388b17da9612d77bc9f600d525e",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "@elcoosp/docs-toolkit": "github:elcoosp/docs-toolkit#366fd96a041b8a5d342913af9c35a1f00d2834eb"
