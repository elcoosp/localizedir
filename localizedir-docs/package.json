{
  "name": "localizedir-docs",
  "version": "0.2.0",
  "description": "Documentation site for localizedir — compile-time localized directory inclusion for Rust",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-llms.mjs",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "lint": "markdownlint-cli2",
    "qa": "node scripts/qa-screenshots.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#c4b8331abb1dc2f157d62fba634eeb17f5e689cd",
    "jsdom": "26.1.0",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "@elcoosp/docs-toolkit": "github:elcoosp/docs-toolkit#dd2fa6d7981534c0e3b230f4eed59e38bd51e4e5"
  },
  "pnpm": {
