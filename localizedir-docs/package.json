{
  "name": "localizedir-docs",
  "version": "0.2.0",
  "description": "Documentation site for localizedir \u2014 compile-time localized directory inclusion for Rust",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "lint": "markdownlint-cli2",
    "qa": "node scripts/qa-screenshots.mjs",
    "build": "astro build",
    "predev": "mkdir -p src/content/i18n && cp -r node_modules/@elcoosp/docs-toolkit/i18n/* src/content/i18n/ 2>/dev/null || true",
    "prebuild": "mkdir -p src/content/i18n && cp -r node_modules/@elcoosp/docs-toolkit/i18n/* src/content/i18n/ 2>/dev/null || true"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0",
    "mermaid": "^11.0.0",
    "@elcoosp/docs-toolkit": "^0.5.10"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#4bb9e47833c48388b17da9612d77bc9f600d525e",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "@elcoosp/docs-toolkit": "^0.5.10"
  }
}
