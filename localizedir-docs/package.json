{
  "name": "localizedir-docs",
  "version": "0.2.0",
  "description": "Documentation site for localizedir \u2014 compile-time localized directory inclusion for Rust",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-llms.mjs",
    "preview": "astro preview",
