{
  "name": "localizedir-docs",
  "version": "0.2.0",
  "description": "Documentation site for localizedir — compile-time localized directory inclusion for Rust",
  "private": true,
  "scripts": {
    "dev": "tsx ./node_modules/astro/bin/astro.mjs dev",
    "preview": "tsx ./node_modules/astro/bin/astro.mjs preview",
    "check": "tsx ./node_modules/astro/bin/astro.mjs check",
    "lint": "markdownlint-cli2",
    "qa": "node scripts/qa-screenshots.mjs",
    "build": "tsx ./node_modules/astro/bin/astro.mjs build",
    "predev": "mkdir -p src/content/i18n && cp -r node_modules/@elcoosp/docs-toolkit/i18n/* src/content/i18n/ 2>/dev/null || true",
    "prebuild": "mkdir -p src/content/i18n && cp -r node_modules/@elcoosp/docs-toolkit/i18n/* src/content/i18n/ 2>/dev/null || true"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.11",
    "@d2lang/d2": "^0.1.34",
    "@elcoosp/docs-toolkit": "^0.7.1",
    "astro": "7.4.11",
    "astro-d2": "^0.14.1",
    "linkedom": "^0.18.0",
    "mermaid": "^11.0.0",
    "starlight-announcement": "^2.0.0",
    "starlight-auto-sidebar": "^0.4.1",
    "starlight-blog": "^0.30.2",
    "starlight-changelogs": "^0.7.1",
    "starlight-heading-badges": "^0.8.0",
    "starlight-image-zoom": "^0.16.2",
    "starlight-scroll-to-top": "^2.0.0",
    "starlight-seo": "^1.0.0",
    "starlight-telescope": "^1.0.0",
    "starlight-view-modes": "^0.15.4",
    "starlight-links-validator": "^0.27.0"
  },
  "devDependencies": {
    "@elcoosp/docs-toolkit": "^0.7.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tsx": "^4.19.2",
    "typescript": "6.0.3"
  }
}
